{
  "name": "eet-ts",
  "version": "1.0.0",
  "description": "TypeScript SDK for the EET 2.0 SOAP API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:playground": "EET_PLAYGROUND_TEST=1 vitest run test/playground.test.ts --testTimeout 30000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/node-forge": "^1.3.14",
    "fflate": "^0.8.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.9.3",
    "node-forge": "^1.4.0",
    "xml-crypto": "^6.1.2"
  }
}
