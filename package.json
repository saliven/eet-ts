{
  "name": "eet-ts",
  "version": "1.0.0",
  "description": "TypeScript SDK for the EET 2.0 SOAP API",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/saliven/eet-ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean --sourcemap && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run --exclude test/playground.test.ts",
    "test:playground": "vitest run test/playground.test.ts --testTimeout 30000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.9.3",
    "node-forge": "^1.4.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/node-forge": "^1.3.14",
    "fflate": "^0.8.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.86.0",
    "tsup": "9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
